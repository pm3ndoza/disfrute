---
import { render } from "astro:content";
import { ui, type Idioma } from "../i18n";
import { texto } from "../lib/contenido";
import { ruta } from "../lib/url";

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const historia = await texto("historia", lang);
const { Content } = await render(historia);
const { titulo, foto } = historia.data;
---

<section id="esencia" class="seccion seccion--morado seccion--deco">
  <img class="deco deco--banano" src={ruta("img/deco/banano.webp")} alt="" width="600" height="845" loading="lazy" />
  <div class="contenedor historia">
    {foto && <img class="historia__foto revelar" src={ruta(`img/${foto}`)} alt={ui[lang].historiaAlt} loading="lazy" width="900" height="900" />}
    <div class="texto revelar">
      <h2>{titulo}</h2>
      <Content />
    </div>
  </div>
</section>
