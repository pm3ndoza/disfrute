---
import { idiomas, nombresIdioma, rutaIdioma, ui, type Idioma } from "../i18n";
import { ruta } from "../lib/url";

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = ui[lang];
const links = (["esencia", "menu", "encontranos", "contacto"] as const).map((id) => ({
  href: `#${id === "menu" ? "productos" : id}`,
  texto: t.nav[id],
}));
---

<header class="header">
  <!-- Brand book: sobre morado solo va la versión blanca del logo -->
  <a href="#inicio" class="marca">
    <img src={ruta("img/logo-blanco.webp")} alt={t.inicioAlt} width="1000" height="405" />
  </a>
  <nav class="header__nav" aria-label={t.navAria}>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}
    </ul>
  </nav>
  <nav class="idiomas" aria-label={t.idiomaAria}>
    {
      idiomas.map((i) => (
        <a
          href={rutaIdioma(i)}
          hreflang={i}
          lang={i}
          title={nombresIdioma[i]}
          aria-label={nombresIdioma[i]}
          aria-current={i === lang ? "page" : undefined}
        >
          {i.toUpperCase()}
        </a>
      ))
    }
  </nav>
</header>
