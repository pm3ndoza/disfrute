---
import { getCollection, getEntry, render } from "astro:content";
import { ui, type Idioma } from "../i18n";
import { texto } from "../lib/contenido";
import { ruta } from "../lib/url";

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = ui[lang];
const acai = await texto("acai", lang);
const { Content: Intro } = await render(acai);
const toppings = await getEntry("toppings", "toppings");
if (!toppings) throw new Error("Falta src/content/toppings.md");

const productos = (await getCollection("productos", ({ data }) => data.disponible)).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const categorias = (["vasos", "bowls"] as const)
  .map((id) => ({ nombre: t.categorias[id], items: productos.filter((p) => p.data.categoria === id) }))
  .filter((c) => c.items.length > 0);

const { precio_extra } = toppings.data;
const grupos = (["salsas", "secos", "frutas"] as const).map((id) => ({
  nombre: t.grupos[id],
  items: toppings.data[id].map((x) => x[lang]),
}));
---

<section id="productos" class="seccion seccion--crema seccion--deco">
  <img class="deco deco--rama" src={ruta("img/deco/acai-rama.webp")} alt="" width="720" height="643" loading="lazy" />
  <div class="contenedor">
    <div class="acai">
      <div class="acai__fotos revelar">
        {acai.data.fotos.map((f) => <img src={ruta(`img/productos/${f}`)} alt={t.acaiAlt} loading="lazy" width="300" height="400" />)}
      </div>
      <div class="acai__texto revelar">
        <h2>{acai.data.titulo}</h2>
        <Intro />
      </div>
    </div>

    <div class="menu revelar">
      <h2 class="menu__titulo">{t.menuTitulo}</h2>
      {
        categorias.map((c) => (
          <div class="menu__categoria">
            <h3>{c.nombre}</h3>
            <ul class="menu__lista">
              {c.items.map(({ data }) => (
                <li>
                  <span class="menu__nombre">
                    {data.nombre[lang]} {data.detalle && <small>{data.detalle}</small>}
                  </span>
                  <span class="menu__puntos" aria-hidden="true" />
                  <span class="menu__precio">$ {data.precio}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <h3>{t.toppings}</h3>
      <div class="toppings">
        {
          grupos.map((g) => (
            <div>
              <h4>{g.nombre}</h4>
              <ul>{g.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))
        }
      </div>
      <p class="menu__extra">{t.extra} <span>$ {precio_extra} {t.cadaUno}</span></p>
    </div>
  </div>
</section>
