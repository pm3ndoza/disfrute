---
import type { Idioma } from "../i18n";
import { ui } from "../i18n";
import { texto } from "../lib/contenido";
import { ruta } from "../lib/url";

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const t = ui[lang];
const { titulo, lema, subtitulo } = (await texto("hero", lang)).data;
---

<!-- Composición del brand book (pág. 14): logo principal sobre crema, enmarcado por la selva -->
<section id="inicio" class="hero">
  <div class="hero__deco" aria-hidden="true">
    <img class="hero__rama hero__rama--izq" src={ruta("img/deco/acai-rama.webp")} alt="" width="720" height="643" />
    <img class="hero__rama hero__rama--der" src={ruta("img/deco/acai-rama.webp")} alt="" width="720" height="643" />
    <img class="hero__loro" src={ruta("img/deco/loro.webp")} alt="" width="520" height="597" />
    <img class="hero__flor" src={ruta("img/deco/flor-roja.webp")} alt="" width="320" height="500" />
    <img class="hero__tucan" src={ruta("img/deco/tucan.webp")} alt="" width="460" height="659" />
  </div>
  <div class="hero__contenido">
    <h1><img class="hero__logo" src={ruta("img/logo.webp")} alt={titulo} width="1000" height="405" fetchpriority="high" /></h1>
    <p class="lema">{lema}</p>
    <p class="hero__texto">{subtitulo}</p>
    <div class="botones">
      <a class="boton boton--morado" href="#productos">{t.verMenu}</a>
      <a class="boton boton--verde" href="#encontranos">{t.visitanos}</a>
    </div>
  </div>
</section>
